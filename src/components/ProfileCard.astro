---
const actions = [
    {
        href: "mailto:bllin001@odu.edu",
        label: "Email Me",
        className: "button-link button-link--primary",
        external: false,
    },
    {
        href: "https://www.linkedin.com/in/brian-jesus-llinas-marimon/",
        label: "LinkedIn",
        className: "button-link button-link--secondary",
        external: true,
    },
    {
        href: "https://scholar.google.com/citations?hl=en&user=nE29OcUAAAAJ",
        label: "Google Scholar",
        className: "button-link button-link--outline",
        external: true,
    },
    {
        href: "/CV_EN_Brian_Llinas.pdf",
        label: "Download CV",
        className: "button-link button-link--outline",
        external: true,
    },
];

const socialLinks = [
    { href: "https://github.com/bllin001", label: "GitHub" },
    { href: "https://x.com/brianllinas", label: "X (Twitter)" },
    {
        href: "https://www.researchgate.net/profile/Brian-Llinas-Marimon",
        label: "ResearchGate",
    },
    {
        href: "https://orcid.org/0009-0002-1344-9168",
        label: "ORCID",
    },
];
---

<aside class="profile-card">
    <img
        src="/Profile.png"
        alt="Portrait of Brian Llinás"
        width="200"
        height="200"
    />

    <p class="profile-card__name">Brian Llinás</p>

    <p class="profile-card__role">
        Ph.D. Student · Computer Science
        <br />
        Old Dominion University
    </p>

    <p class="profile-card__location">
        Norfolk, Virginia · Graduate Research Assistant
    </p>

    <div class="profile-card__actions">
        {
            actions.map((action) => (
                <a
                    class={action.className}
                    href={action.href}
                    target={action.external ? "_blank" : undefined}
                    rel={action.external ? "noopener noreferrer" : undefined}
                >
                    {action.label}
                </a>
            ))
        }
    </div>

    <div class="profile-card__social-links">
        {
            socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                </a>
            ))
        }
    </div>
</aside>

<style>
    .profile-card {
        padding: 32px 24px;
        text-align: center;
        background: var(--color-background);
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(15, 37, 63, 0.12);
    }

    .profile-card img {
        width: 180px;
        height: 180px;
        margin-bottom: 16px;
        object-fit: cover;
        border: 4px solid #eef3fa;
        border-radius: 50%;
    }

    .profile-card__name {
        margin: 12px 0 8px;
        color: #1f2d3d;
        font-size: 1.5em;
        font-weight: 700;
        line-height: 1.2;
    }

    .profile-card__role {
        margin-bottom: 12px;
        color: var(--color-heading);
        font-size: 1.05em;
        line-height: 1.5;
    }

    .profile-card__location {
        margin-bottom: 24px;
        color: #6c7a89;
        font-size: 0.95em;
    }

    .profile-card__actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        margin-bottom: 24px;
        gap: 12px;
    }

    .profile-card__social-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .profile-card__social-links a {
        padding: 6px 14px;
        color: var(--color-primary);
        font-size: 0.9em;
        font-weight: 500;
        text-decoration: none;
        background: var(--color-soft-blue);
        border-radius: 999px;
        transition: background 0.2s ease;
    }

    .profile-card__social-links a:hover {
        background: #d3e0f2;
    }

    @media (max-width: 600px) {
        .profile-card__actions {
            grid-template-columns: 1fr;
        }
    }
</style>
