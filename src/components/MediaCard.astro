---
import type { MediaEntry } from "../types/media";

interface Props {
	entry: MediaEntry;
}

const { entry } = Astro.props;

const platformNames: Record<string, string> = {
	"storymodelers.org": "Storymodelers",
	"www.storymodelers.org": "Storymodelers",
	"ws-dl.blogspot.com": "WS-DL Blog",
	"medium.com": "Medium",
};

const hostname = new URL(entry.url).hostname.toLowerCase();
const source =
	platformNames[hostname] ||
	hostname
		.replace(/^www\./, "")
		.split(".")
		.at(-2)
		?.replaceAll("-", " ")
		.replace(/\b\w/g, (letter) => letter.toUpperCase()) ||
	"External Link";

const primaryLabel = platformNames[hostname] ? "Blog" : "Visit";
const formattedDate = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(entry.date));

const authorParts = entry.authors.split(/(Brian Llinas)/i);
---

<article class="media-card">
	<a
		class="media-card__figure"
		href={entry.url}
		target="_blank"
		rel="noopener noreferrer"
	>
		{
			entry.image ? (
				<img
					class="media-card__image"
					src={entry.image}
					alt={`${entry.title} preview`}
					loading="lazy"
				/>
			) : (
				<div class="media-card__image media-card__image--placeholder" />
			)
		}
	</a>

	<div class="media-card__body">
		<div class="media-card__meta">
			<span class="media-card__source">{source}</span>
			<time class="media-card__date" datetime={entry.date}>
				{formattedDate}
			</time>
		</div>

		<h4 class="media-card__title">
			<a href={entry.url} target="_blank" rel="noopener noreferrer">
				{entry.title}
			</a>
		</h4>

		<p class="media-card__authors">
			{
				authorParts.map((part) =>
					part.toLowerCase() === "brian llinas" ? (
						<strong>{part}</strong>
					) : (
						part
					),
				)
			}
		</p>

		<div class="media-card__actions">
			<a
				class="badge-link"
				href={entry.url}
				target="_blank"
				rel="noopener noreferrer"
			>
				{primaryLabel}
			</a>

			{
				entry.github && (
					<a
						class="badge-link badge-secondary"
						href={entry.github}
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub Repository
					</a>
				)
			}
		</div>
	</div>
</article>

<style>
	.media-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #fff;
		border-radius: 24px;
		box-shadow: 0 16px 40px rgba(23, 68, 107, 0.08);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.media-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 22px 50px rgba(23, 68, 107, 0.14);
	}

	.media-card__figure {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: linear-gradient(135deg, #dbe9fb, #f2f4f8);
	}

	.media-card__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.media-card__image--placeholder {
		background: linear-gradient(135deg, #dfe7f5, #f2f5fb);
	}

	.media-card__body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-height: 220px;
		padding: 22px 24px 24px;
	}

	.media-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.85em;
		color: #6b7a90;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}

	.media-card__title {
		margin: 0;
		font-size: 1.08em;
		line-height: 1.35;
		color: #1d2e45;
	}

	.media-card__title a {
		color: inherit;
		text-decoration: none;
	}

	.media-card__title a:hover {
		color: #17446b;
	}

	.media-card__authors {
		margin: 0;
		font-size: 0.98em;
		line-height: 1.6;
		color: #2f3b4c;
	}

	.media-card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: auto;
	}

	@media (max-width: 640px) {
		.media-card__body {
			padding: 20px;
		}
	}
</style>
