---
const currentYear = new Date().getFullYear();

const siteLinks = [
    { href: "/", label: "About" },
    { href: "/publications", label: "Publications" },
    { href: "/media", label: "Media & Outreach" },
    { href: "/cv", label: "CV" },
];

const socialLinks = [
    {
        href: "https://www.linkedin.com/in/brian-jesus-llinas-marimon/",
        label: "LinkedIn",
    },
    {
        href: "https://github.com/bllin001",
        label: "GitHub",
    },
];
---

<footer class="site-footer">
    <div class="footer-top">
        <div>
            <strong>© 2024–{currentYear} Brian Llinás</strong>
            <br />
            <a href="mailto:bllin001@odu.edu">bllin001@odu.edu</a>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
            {siteLinks.map((link) => <a href={link.href}>{link.label}</a>)}

            {
                socialLinks.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>

    <div class="footer-bottom">
        <div class="footer-bottom-inner">
            <span>Site maintained by Brian Llinás.</span>
            <span>
                Template available on{" "}
                <a
                    href="https://github.com/bllin001/bllin001.github.io"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    GitHub
                </a>.
            </span>
        </div>
    </div>
</footer>
