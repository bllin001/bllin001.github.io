---
import Layout from "../layouts/Layout.astro";

const cvPath = "/CV_EN_Brian_Llinas.pdf";
---

<Layout
	title="Curriculum Vitae | Brian Llinás"
	description="Curriculum vitae of Brian Llinás, Ph.D. student and computer science researcher."
>
	<div class="cv-page">
		<div class="cv-page__container">
			<section class="cv-page__header">
				<div>
					<h1 id="cv-title">Curriculum Vitae</h1>
					<p class="cv-page__subtitle">
						Review the embedded CV or download a copy for offline
						reference.
					</p>
				</div>

				<a
					class="button-link button-link--primary"
					href={cvPath}
					download
				>
					Download PDF
				</a>
			</section>

			<section class="cv-page__viewer" aria-labelledby="cv-title">
				<div class="cv-page__frame">
					<object
						data={cvPath}
						type="application/pdf"
						class="cv-page__embed"
					>
						<p>
							Your browser doesn't support inline PDFs.
							<a
								href={cvPath}
								target="_blank"
								rel="noopener noreferrer"
							>
								Open the CV in a new tab.
							</a>
						</p>
					</object>
				</div>

				<p class="cv-page__note">
					Need a separate window?
					<a
						href={cvPath}
						target="_blank"
						rel="noopener noreferrer"
					>
						Open the CV as a standalone PDF
					</a>.
				</p>
			</section>
		</div>
	</div>
</Layout>

<style>
	.cv-page {
		padding: 48px 16px 72px;
		background: var(--color-background);
	}

	.cv-page__container {
		display: flex;
		flex-direction: column;
		max-width: 1100px;
		margin: 0 auto;
		gap: 28px;
	}

	.cv-page__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		padding: 28px 32px;
		background: var(--color-surface);
		border: 1px solid rgba(23, 68, 107, 0.08);
		border-radius: 20px;
		box-shadow: 0 16px 40px rgba(23, 68, 107, 0.12);
		gap: 20px;
	}

	.cv-page__header h1 {
		margin: 0 0 8px;
		color: var(--color-text-strong);
	}

	.cv-page__subtitle {
		margin: 0;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.cv-page__viewer {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.cv-page__frame {
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid rgba(23, 68, 107, 0.08);
		border-radius: 20px;
		box-shadow: 0 18px 42px rgba(23, 68, 107, 0.1);
	}

	.cv-page__embed {
		display: block;
		width: 100%;
		height: 78vh;
		border: none;
	}

	.cv-page__note {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95em;
	}

	.cv-page__note a {
		color: var(--color-primary);
		font-weight: 600;
	}

	.cv-page__note a:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.cv-page__header {
			flex-direction: column;
			align-items: stretch;
			padding: 24px;
		}

		.cv-page__embed {
			height: 70vh;
		}
	}
</style>
